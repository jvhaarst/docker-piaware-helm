{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchPackageNames": [
        "ghcr.io/sdr-enthusiasts/docker-piaware"
      ],
      "matchFileNames": [
        "piaware/values.yaml"
      ],
      "versioning": "regex:^latest-build-(?<patch>\\d+)$",
      "bumpVersions": [
        {
          "filePatterns": [
            "piaware/Chart.yaml"
          ],
          "matchStrings": [
            "version:\\s(?<version>[^\\s]+)"
          ],
          "bumpType": "patch"
        }
      ]
    },
    {
      "matchPackageNames": [
        "ghcr.io/sdr-enthusiasts/docker-piaware"
      ],
      "matchFileNames": [
        "piaware/Chart.yaml"
      ],
      "versioning": "regex:^build-(?<patch>\\d+)$"
    },
    {
      "matchPackageNames": [
        "ghcr.io/sdr-enthusiasts/docker-piaware"
      ],
      "groupName": "piaware image"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/piaware/values\\.yaml$/"
      ],
      "matchStrings": [
        "repository:\\s*(?<depName>ghcr\\.io/sdr-enthusiasts/docker-piaware)\\s*\\n\\s*tag:\\s*(?<currentValue>latest-build-\\d+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^latest-build-(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/piaware/Chart\\.yaml$/"
      ],
      "matchStrings": [
        "appVersion:\\s*\"(?<currentValue>build-\\d+)\""
      ],
      "depNameTemplate": "ghcr.io/sdr-enthusiasts/docker-piaware",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^build-(?<patch>\\d+)$",
      "extractVersionTemplate": "^latest-(?<version>build-\\d+)$"
    }
  ]
}
